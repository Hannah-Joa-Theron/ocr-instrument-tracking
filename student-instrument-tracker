  {
    "id": "fn_set_type_sticky",
    "type": "function",
    "z": "241b5018e2081728",
    "name": "Set sticky instrument type (per chat)",
    "func": "const chatId = msg.payload?.chatId;\nconst text = (msg.payload?.content || \"\").trim();\n\nif (!chatId || !text) return null;\n\n// allow clearing\nif (text.toLowerCase() === \"clear\") {\n  flow.set(\"instrumentType:\" + chatId, null);\n  msg.payload = {\n    chatId,\n    type: \"message\",\n    content: \"✅ Instrument type cleared. Next photo must include a type or you must set it again.\"\n  };\n  return msg;\n}\n\n// normalise user text to same parser as captions\nconst cap = text;\n\n// store raw, we will standardise now for safety\nlet c = cap.toLowerCase().trim();\n\nc = c\n  .replace(/[\\/_\\-]+/g, \" \")\n  .replace(/\\s+/g, \" \");\n\nc = c.replace(/redlight/g, \"red light\")\n     .replace(/bluelight/g, \"blue light\")\n     .replace(/reds(?:ound)?meter/g, \"red sound\")\n     .replace(/blues(?:ound)?meter/g, \"blue sound\");\n\nlet t = \"unknown\";\n\nif (c.includes(\"red\")) {\n  if (c.includes(\"temp\") || c.includes(\"hum\") || c.includes(\"humid\")) t = \"red_temp_hum\";\n  else if (c.includes(\"sound\")) t = \"red_sound\";\n  else if (c.includes(\"light\")) t = \"red_light\";\n}\n\nif (c.includes(\"blue\")) {\n  if (c.includes(\"air\") || c.includes(\"velocity\") || c.includes(\"velo\")) t = \"blue_air_velocity\";\n  else if (c.includes(\"sound\")) t = \"blue_sound\";\n  else if (c.includes(\"light\")) t = \"blue_light\";\n}\n\nflow.set(\"instrumentType:\" + chatId, t);\n\nmsg.payload = {\n  chatId,\n  type: \"message\",\n  content: (t === \"unknown\")\n    ? `⚠️ I couldn't understand that type: \"${text}\"\\nTry: red light / red sound / red temp hum / blue light / blue sound / blue air`\n    : `✅ Instrument type set to: ${t}\\n(Sticky for this chat. Now resend your photo.)`\n};\n\nreturn msg;",
    "outputs": 1,
    "x": 390,
    "y": 120,
    "wires": [
      [
        "e03741314b0e36de"
      ]
    ]
  },

  {
    "id": "fn_std_type_short_v2",
    "type": "function",
    "z": "241b5018e2081728",
    "name": "Standardise instrument type (caption OR sticky)",
    "func": "const chatId = msg.payload?.chatId;\n\n// caption on the photo (optional)\nlet c = (msg.payload.caption || \"\").toLowerCase().trim();\n\n// normalise separators and whitespace\nc = c\n  .replace(/[\\/_\\-]+/g, \" \")\n  .replace(/\\s+/g, \" \");\n\n// collapse joined words\nc = c.replace(/redlight/g, \"red light\")\n     .replace(/bluelight/g, \"blue light\")\n     .replace(/reds(?:ound)?meter/g, \"red sound\")\n     .replace(/blues(?:ound)?meter/g, \"blue sound\");\n\nlet t = \"unknown\";\n\nif (c.includes(\"red\")) {\n  if (c.includes(\"temp\") || c.includes(\"hum\") || c.includes(\"humid\")) t = \"red_temp_hum\";\n  else if (c.includes(\"sound\")) t = \"red_sound\";\n  else if (c.includes(\"light\")) t = \"red_light\";\n}\n\nif (c.includes(\"blue\")) {\n  if (c.includes(\"air\") || c.includes(\"velocity\") || c.includes(\"velo\")) t = \"blue_air_velocity\";\n  else if (c.includes(\"sound\")) t = \"blue_sound\";\n  else if (c.includes(\"light\")) t = \"blue_light\";\n}\n\n// If caption didn't give a type, try sticky per-chat\nif (t === \"unknown\" && chatId) {\n  const sticky = flow.get(\"instrumentType:\" + chatId);\n  if (sticky) t = sticky;\n}\n\nmsg.instrument_type = t;\nmsg.chatId = chatId;\n\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 240,
