  {
    "id": "c06065bc4ee2aa4c",
    "type": "function",
    "z": "241b5018e2081728",
    "name": "Parse OCR → student_number + instrument_number",
    "func": "let ocrText = msg.payload?.ParsedResults?.[0]?.ParsedText || \"\";\n\nocrText = ocrText\n  .replace(/\\bg\\b/gi, \"9\")\n  .replace(/\\bb\\b/gi, \"8\")\n  .replace(/O/g, \"0\");\n\nlet candidates = ocrText.match(/\\b[0-9A-Z]{6,}\\b/gi) || [];\n\nlet studentNumber = null;\nlet instrumentNumber = null;\n\nfor (const wordRaw of candidates) {\n  const word = wordRaw.toUpperCase();\n  const digitCount = (word.match(/\\d/g) || []).length;\n  const ratio = digitCount / word.length;\n  if (ratio < 0.8) continue;\n\n  if (!studentNumber && /^\\d{8}$/.test(word)) {\n    studentNumber = word;\n    continue;\n  }\n  if (!instrumentNumber && /^\\d{9,}$/.test(word)) {\n    instrumentNumber = word;\n  }\n}\n\nmsg.data = {\n  student_number: studentNumber || \"Not found\",\n  instrument_number: instrumentNumber || \"Not found\",\n  instrument_type: msg.instrument_type || \"unknown\"\n};\n\nmsg.instrument_number = msg.data.instrument_number;\n\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1460,
    "y": 480,
    "wires": [
