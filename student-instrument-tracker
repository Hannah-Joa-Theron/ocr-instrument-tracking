  {
    "id": "a241d0716c5d010b",
    "type": "function",
    "z": "241b5018e2081728",
    "name": "Validate + reply + send to Influx",
    "func": "const chatId = msg.chatId;\nconst s = msg.data?.student_number;\nconst i = msg.data?.instrument_number;\nconst t = msg.data?.instrument_type || msg.instrument_type || \"unknown\";\n\nconst ok = s && i && s !== \"Not found\" && i !== \"Not found\";\n\nlet reply = {\n  payload: {\n    chatId,\n    type: \"message\",\n    content: ok\n      ? `✅ Captured\\nStudent: ${s}\\nInstrument: ${i}\\nType: ${t}\\n\\nSending to InfluxDB...`\n      : `⚠️ Could not capture both numbers.\\nStudent: ${s}\\nInstrument: ${i}\\nType: ${t}\\n\\nPlease send a clearer photo.`\n  }\n};\n\nif (!ok) return [reply, null];\n\nlet toInflux = {\n  chatId,\n  data: {\n    ...msg.data,\n    instrument_type: t\n  },\n  instrument_number: msg.instrument_number,\n  instrument_type: t,\n  tempPath: msg.tempPath\n};\n\nreturn [reply, toInflux];",
